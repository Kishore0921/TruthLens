DATABASE_URL=sqlite:///./truthlens.db
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=104857600

APP_SECRET_KEY=replace_with_a_secure_random_secret
FERNET_MASTER_KEY=replace_with_a_persistent_fernet_key

# Hugging Face
HF_TOKEN=your_huggingface_access_token

# Google Gemini
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# AI Configuration
ENABLE_HUGGINGFACE=true
ENABLE_GEMINI=true
ENABLE_OPENAI=true
AI_EXECUTION_MODE=hybrid

# Hardware Safeguards (Intel Core i5-4310U, 8GB RAM, CPU-first)
MAX_IMAGE_INFERENCE_DIM=512
MAX_VIDEO_SAMPLE_FRAMES=10
MAX_AUDIO_DURATION_S=15.0
