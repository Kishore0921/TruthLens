# TruthLens Environment Configuration
# API keys are configured here manually by the developer and loaded automatically on startup.
# Never commit actual API keys to version control.

# Execution Mode: HYBRID (default), LOCAL (offline forensic models only), CLOUD (external APIs preferred)
EXECUTION_MODE=HYBRID

# Optional Cloud AI Credentials
# Leave empty to run in 100% offline local forensic mode
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# Model Defaults
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
HF_DEFAULT_MODEL=umm-maybe/AI-image-detector

# Storage and Database Configuration
DATABASE_URL=sqlite:///./truthlens.db
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=104857600

# Security & Master Salt
APP_SECRET_KEY=truthlens-production-secret-key-local-mvp
FERNET_MASTER_KEY=

# Hardware Optimization Safeguards (Intel Core i5-4310U, 8GB RAM, CPU-first)
MAX_IMAGE_INFERENCE_DIM=512
MAX_VIDEO_SAMPLE_FRAMES=10
MAX_AUDIO_DURATION_S=15.0
